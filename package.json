{
  "name": "serial-workbench",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.13.0",
    "pnpm": "^12.16.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:web": "tsc && vite build --mode web-preview",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "doctor": "node scripts/doctor.mjs",
    "config:check": "node scripts/init-project.mjs --check && node scripts/repository-config.mjs check",
    "repository:sync": "node scripts/repository-config.mjs sync",
    "repository:check": "node scripts/repository-config.mjs check",
    "bindings:generate": "node scripts/generate-bindings.mjs",
    "bindings:check": "node scripts/generate-bindings.mjs --check",
    "branding:generate": "node scripts/branding.mjs",
    "branding:check": "node scripts/branding.mjs --check",
    "e2e:build": "node e2e/build.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test:browser": "playwright test",
    "test:ui": "pnpm build:web && pnpm test:browser",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs e2e/*.test.mjs",
    "test:installer": "node scripts/installer-layout.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "node scripts/verify.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:outputs": "node scripts/clean.mjs --outputs",
    "clean:artifacts": "node scripts/clean.mjs --artifacts",
    "clean:temporary": "node scripts/clean.mjs --temporary",
    "clean:all": "node scripts/clean.mjs --all",
    "version:set": "node scripts/version.mjs set",
    "version:check": "node scripts/version.mjs check",
    "release:notes": "node scripts/release-lib.mjs notes",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "node scripts/app-build.mjs",
    "app:portable": "node scripts/portable.mjs",
    "config:sync": "node scripts/init-project.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "highlight.js": "11.11.1",
    "lowlight": "3.3.0",
    "lucide-react": "^1.59.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.5",
    "webdriverio": "^9.32.0"
  },
  "description": "Cross-platform serial port workbench built with Tauri and Rust.",
  "author": "YanChao",
  "repository": {
    "type": "git",
    "url": "https://github.com/YanChao001/serial-workbench"
  },
  "homepage": "https://github.com/YanChao001/serial-workbench",
  "keywords": [
    "serial-workbench",
    "serial-studio",
    "serial-port",
    "serial-monitor",
    "serial-terminal",
    "uart",
    "embedded",
    "tauri",
    "rust",
    "react",
    "typescript",
    "cross-platform",
    "serial",
    "serial-communication"
  ]
}
