{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Serial Workbench",
  "version": "0.1.12",
  "identifier": "io.github.yanchao001.serialworkbench",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Serial Workbench",
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src extension-ui: http://extension-ui.localhost https://extension-ui.localhost; media-src 'self' blob: wallpaper-media: http://wallpaper-media.localhost https://wallpaper-media.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; connect-src 'self' ipc: http://ipc.localhost https://httpbin.org https://jsonplaceholder.typicode.com wss://echo.websocket.events",
      "devCsp": null
    }
  },
  "plugins": {
    "http": {
      "scopeRedirects": true
    },
    "deep-link": {
      "desktop": {
        "schemes": ["serial-workbench"]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "resources": {
      "../resources/third-party/extism.LICENSE": "third-party/extism.LICENSE",
      "../resources/third-party/wasmtime.LICENSE": "third-party/wasmtime.LICENSE",
      "../resources/third-party/tauri.LICENSE": "third-party/tauri.LICENSE",
      "../resources/third-party/webview2-com.LICENSE": "third-party/webview2-com.LICENSE",
      "../resources/third-party/windows-core.LICENSE": "third-party/windows-core.LICENSE",
      "../resources/third-party/async-compression.LICENSE": "third-party/async-compression.LICENSE",
      "../resources/third-party/if-addrs.LICENSE": "third-party/if-addrs.LICENSE"
    },
    "fileAssociations": [
      {
        "ext": ["swbench"],
        "name": "Serial Workbench Document",
        "description": "UTF-8 Serial Workbench document",
        "role": "Editor",
        "mimeType": "application/x-swbench"
      }
    ],
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A cross-platform serial workbench",
    "copyright": "© 2026 YanChao",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "template": "installer/installer.nsi",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "installer/header.bmp"
      },
      "wix": {
        "language": "zh-CN",
        "fragmentPaths": ["installer/wix-ui.wxs"],
        "componentGroupRefs": ["StarterInstallerUI"],
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "publisher": "YanChao",
    "homepage": "https://github.com/YanChao001/serial-workbench"
  }
}
