{
  "schemaVersion": "0.1",
  "id": "swb.reference.modbus",
  "version": "0.1.1",
  "displayName": "Modbus Master",
  "description": "Send a paced Modbus request and trace its session response",
  "license": "Apache-2.0",
  "notices": ["LICENSE", "NOTICE"],
  "hostProtocolVersion": "0.1",
  "runtimeRef": "node-26.13.0",
  "main": "dist/main.mjs",
  "dependencies": [],
  "platformResources": [],
  "activation": ["startup"],
  "permissions": {
    "hostApi": [
      {
        "permissions": ["metadata.read", "content.read", "device.modify"],
        "targetKinds": ["session"]
      }
    ],
    "executionPurposes": ["automation"],
    "externalTools": []
  },
  "contributes": {
    "actions": [
      {
        "actionId": "swb.reference.modbus.transaction",
        "kind": "action",
        "inputSchema": {
          "type": "object",
          "properties": {
            "transport": {
              "enum": ["rtu", "ascii", "tcp"]
            },
            "requestBase64": {
              "type": "string",
              "minLength": 4,
              "maxLength": 684,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "unitRouting": {
              "enum": ["gateway", "direct"]
            },
            "startEventSeq": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$",
              "default": "1"
            },
            "responseTimeoutMs": {
              "type": "integer",
              "minimum": 50,
              "maximum": 5000,
              "default": 1000
            },
            "lateResponseWaitMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3000,
              "default": 0
            },
            "broadcastTurnaroundMs": {
              "type": "integer",
              "minimum": 10,
              "maximum": 2000,
              "default": 150
            },
            "retryLimit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2,
              "default": 0
            },
            "includeTrace": {
              "type": "boolean",
              "default": false
            }
          },
          "required": ["transport", "requestBase64"],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "operationId": {
              "type": "string"
            },
            "outcome": {
              "enum": [
                "matched",
                "device_exception",
                "invalid_response",
                "response_timeout",
                "source_changed",
                "transmit_unconfirmed",
                "broadcast_completed"
              ]
            },
            "ignoredFrames": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            },
            "turnaroundMs": {
              "type": "integer",
              "minimum": 10,
              "maximum": 2000
            },
            "response": {
              "$ref": "#/$defs/received"
            },
            "lateResponse": {
              "$ref": "#/$defs/received"
            },
            "retryStopped": {
              "enum": ["partial_frame", "lease_budget"]
            },
            "attempts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "properties": {
                  "operationId": {
                    "$ref": "#/properties/operationId"
                  },
                  "outcome": {
                    "$ref": "#/properties/outcome"
                  },
                  "ignoredFrames": {
                    "$ref": "#/properties/ignoredFrames"
                  },
                  "response": {
                    "$ref": "#/$defs/received"
                  },
                  "lateResponse": {
                    "$ref": "#/$defs/received"
                  },
                  "trace": {
                    "type": "object",
                    "properties": {
                      "tx": {
                        "$ref": "#/$defs/timingPoint"
                      },
                      "rxFirst": {
                        "$ref": "#/$defs/timingPoint"
                      },
                      "rxLast": {
                        "$ref": "#/$defs/timingPoint"
                      }
                    },
                    "required": ["tx"],
                    "dependentRequired": {
                      "rxFirst": ["rxLast"],
                      "rxLast": ["rxFirst"]
                    },
                    "additionalProperties": false
                  },
                  "requestTransactionId": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  }
                },
                "required": ["operationId", "outcome", "ignoredFrames"],
                "additionalProperties": false
              }
            }
          },
          "required": ["operationId", "outcome", "ignoredFrames"],
          "additionalProperties": false,
          "$defs": {
            "timingPoint": {
              "type": "object",
              "properties": {
                "eventSeq": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,19}$"
                },
                "clockId": {
                  "type": "string"
                },
                "monoNs": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "resolutionNs": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "source": {
                  "$ref": "#/$defs/precision/properties/source"
                }
              },
              "required": [
                "eventSeq",
                "clockId",
                "monoNs",
                "source",
                "resolutionNs"
              ],
              "additionalProperties": false
            },
            "precision": {
              "type": "object",
              "properties": {
                "source": {
                  "enum": [
                    "host_read",
                    "device",
                    "line_capture",
                    "sample_clock"
                  ]
                },
                "resolutionNs": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "syncMethod": {
                  "type": "string"
                },
                "offsetEstimateNs": {
                  "type": "string",
                  "pattern": "^-?(?:0|[1-9][0-9]{0,19})$"
                },
                "offsetErrorNs": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "rttNs": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                }
              },
              "required": ["source", "resolutionNs", "syncMethod"],
              "additionalProperties": false
            },
            "source": {
              "type": "object",
              "properties": {
                "hostId": {
                  "type": "string"
                },
                "sessionId": {
                  "type": "string"
                },
                "sessionEpoch": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "direction": {
                  "const": "rx"
                },
                "eventStart": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "eventEnd": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "byteStart": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "byteEnd": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                }
              },
              "required": [
                "hostId",
                "sessionId",
                "sessionEpoch",
                "direction",
                "eventStart",
                "eventEnd",
                "byteStart",
                "byteEnd"
              ],
              "additionalProperties": false
            },
            "timing": {
              "type": "object",
              "properties": {
                "clockId": {
                  "type": "string"
                },
                "txMonoNs": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "rxMonoNs": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "elapsedNs": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "attemptAttribution": {
                  "const": "indeterminate"
                },
                "txPrecision": {
                  "$ref": "#/$defs/precision"
                },
                "rxPrecision": {
                  "$ref": "#/$defs/precision"
                }
              },
              "required": [
                "clockId",
                "txMonoNs",
                "rxMonoNs",
                "txPrecision",
                "rxPrecision"
              ],
              "oneOf": [
                {
                  "required": ["elapsedNs"]
                },
                {
                  "required": ["attemptAttribution"]
                }
              ],
              "additionalProperties": false
            },
            "received": {
              "type": "object",
              "properties": {
                "source": {
                  "$ref": "#/$defs/source"
                },
                "timing": {
                  "$ref": "#/$defs/timing"
                },
                "bytesBase64": {
                  "type": "string",
                  "minLength": 4,
                  "maxLength": 684,
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                },
                "exceptionCode": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 255
                }
              },
              "required": ["source", "timing", "bytesBase64"],
              "additionalProperties": false
            }
          }
        },
        "targetKinds": ["session"],
        "executionLocation": "resource_host",
        "permissions": ["metadata.read", "content.read", "device.modify"],
        "stateScopes": [],
        "eventTypes": [],
        "cancellation": "cooperative",
        "revealTarget": {
          "pageId": "workbench",
          "panelId": "activity"
        }
      }
    ],
    "queries": [],
    "transports": [],
    "parsers": [],
    "views": [],
    "themes": [],
    "configuration": []
  },
  "dataSchemaVersion": "1"
}
