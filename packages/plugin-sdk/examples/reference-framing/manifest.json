{
  "schemaVersion": "0.1",
  "id": "swb.reference.framing",
  "version": "0.1.0",
  "displayName": "Serial Workbench Framing",
  "description": "Scan raw receive data into bounded frames with exact source ranges",
  "license": "Apache-2.0",
  "notices": ["LICENSE", "NOTICE"],
  "hostProtocolVersion": "0.1",
  "runtimeRef": "node-26.13.0",
  "main": "dist/main.mjs",
  "dependencies": [],
  "platformResources": [],
  "activation": ["startup"],
  "permissions": {
    "hostApi": [
      {
        "permissions": ["content.read"],
        "targetKinds": ["session"]
      }
    ],
    "executionPurposes": ["protocol"],
    "externalTools": []
  },
  "contributes": {
    "actions": [],
    "queries": [],
    "transports": [],
    "parsers": [
      {
        "actionId": "swb.reference.framing.scan",
        "kind": "action",
        "inputSchema": {
          "type": "object",
          "properties": {
            "startEventSeq": {
              "$ref": "#/$defs/sequence"
            },
            "endEventSeq": {
              "$ref": "#/$defs/sequence"
            },
            "startByte": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,19})$"
            },
            "fixedLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "delimiterBase64": {
              "$ref": "#/$defs/marker"
            },
            "headerBase64": {
              "$ref": "#/$defs/marker"
            },
            "footerBase64": {
              "$ref": "#/$defs/marker"
            },
            "escapeByte": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "maxFrameLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "idleTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            "lengthField": {
              "type": "object",
              "properties": {
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4095
                },
                "width": {
                  "enum": [1, 2, 4]
                },
                "byteOrder": {
                  "enum": ["be", "le"]
                },
                "adjustment": {
                  "type": "integer",
                  "minimum": -4096,
                  "maximum": 4096
                }
              },
              "required": ["offset", "width", "byteOrder", "adjustment"],
              "additionalProperties": false
            }
          },
          "$defs": {
            "sequence": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "marker": {
              "type": "string",
              "minLength": 4,
              "maxLength": 24,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          },
          "required": ["startEventSeq", "endEventSeq"],
          "not": {
            "anyOf": [
              { "required": ["fixedLength", "delimiterBase64"] },
              { "required": ["fixedLength", "lengthField"] },
              { "required": ["delimiterBase64", "lengthField"] }
            ]
          },
          "anyOf": [
            {
              "required": ["fixedLength"]
            },
            {
              "required": ["delimiterBase64"]
            },
            {
              "required": ["lengthField"]
            },
            {
              "required": ["footerBase64"]
            },
            {
              "required": ["idleTimeoutMs"]
            }
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "frames": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "properties": {
                  "bytesBase64": {
                    "type": "string",
                    "minLength": 4,
                    "maxLength": 5464,
                    "contentEncoding": "base64"
                  },
                  "source": {
                    "type": "object",
                    "properties": {
                      "hostId": {
                        "type": "string"
                      },
                      "sessionId": {
                        "type": "string"
                      },
                      "sessionEpoch": {
                        "$ref": "#/$defs/position"
                      },
                      "direction": {
                        "const": "rx"
                      },
                      "eventStart": {
                        "$ref": "#/$defs/position"
                      },
                      "eventEnd": {
                        "$ref": "#/$defs/position"
                      },
                      "byteStart": {
                        "$ref": "#/$defs/position"
                      },
                      "byteEnd": {
                        "$ref": "#/$defs/position"
                      }
                    },
                    "required": [
                      "hostId",
                      "sessionId",
                      "sessionEpoch",
                      "direction",
                      "eventStart",
                      "eventEnd",
                      "byteStart",
                      "byteEnd"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": ["bytesBase64", "source"],
                "additionalProperties": false
              }
            },
            "nextCursor": {
              "type": "object",
              "properties": {
                "eventSeq": { "$ref": "#/$defs/position" },
                "byteStart": { "$ref": "#/$defs/position" }
              },
              "required": ["eventSeq", "byteStart"],
              "additionalProperties": false
            },
            "incompleteBytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            }
          },
          "$defs": {
            "position": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,19})$"
            }
          },
          "required": ["frames", "incompleteBytes"],
          "additionalProperties": false
        },
        "targetKinds": ["session"],
        "executionLocation": "resource_host",
        "permissions": ["content.read"],
        "stateScopes": [],
        "eventTypes": [],
        "cancellation": "cooperative",
        "revealTarget": {
          "pageId": "workbench"
        }
      }
    ],
    "views": [],
    "themes": [],
    "configuration": []
  },
  "dataSchemaVersion": "1"
}
