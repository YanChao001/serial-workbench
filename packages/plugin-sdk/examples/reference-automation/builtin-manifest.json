{
  "schemaVersion": "0.1",
  "id": "swb.builtin.automation",
  "version": "0.1.8",
  "displayName": "Serial Automation",
  "description": "Schedule sends, run command sequences, and trigger scoped actions",
  "license": "Apache-2.0",
  "notices": ["LICENSE", "NOTICE"],
  "hostProtocolVersion": "0.1",
  "runtimeRef": "node-26.13.0",
  "main": "dist/main.mjs",
  "dependencies": [],
  "platformResources": [],
  "activation": ["startup"],
  "permissions": {
    "hostApi": [
      {
        "permissions": ["metadata.read", "content.read", "device.modify"],
        "targetKinds": ["session"]
      },
      {
        "permissions": ["metadata.read", "device.modify"],
        "targetKinds": ["device"]
      }
    ],
    "executionPurposes": ["automation"],
    "externalTools": []
  },
  "contributes": {
    "actions": [
      {
        "actionId": "swb.builtin.automation.repeat",
        "kind": "action",
        "inputSchema": {
          "type": "object",
          "properties": {
            "sendBase64": {
              "$ref": "#/$defs/frame"
            },
            "periodMs": {
              "type": "integer",
              "minimum": 10,
              "maximum": 60000
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "jitterMs": {
              "description": "Symmetric offset smaller than half the period",
              "type": "integer",
              "minimum": 0,
              "maximum": 29999,
              "default": 0
            },
            "startDelayMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60000,
              "default": 0
            },
            "startOnBase64": {
              "$ref": "#/$defs/frame"
            },
            "startTimeoutMs": {
              "type": "integer",
              "minimum": 50,
              "maximum": 60000,
              "default": 5000
            },
            "stopOnBase64": {
              "$ref": "#/$defs/frame"
            },
            "expectBase64": {
              "$ref": "#/$defs/frame"
            },
            "responseTimeoutMs": {
              "type": "integer",
              "minimum": 50,
              "maximum": 5000,
              "default": 1000
            },
            "startEventSeq": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$",
              "default": "1"
            }
          },
          "required": ["sendBase64", "periodMs", "count"],
          "additionalProperties": false,
          "$defs": {
            "frame": {
              "type": "string",
              "minLength": 4,
              "maxLength": 344,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "outcome": {
              "enum": [
                "completed",
                "start_timeout",
                "stop_condition",
                "unexpected_response",
                "response_timeout",
                "source_changed",
                "transmit_unconfirmed"
              ]
            },
            "completed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "skippedSlots": {
              "type": "integer",
              "minimum": 0
            },
            "attempted": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "operationId": {
                    "type": "string"
                  },
                  "outcome": {
                    "enum": [
                      "written",
                      "matched",
                      "stop_condition",
                      "unexpected_response",
                      "response_timeout",
                      "source_changed",
                      "transmit_unconfirmed"
                    ]
                  },
                  "scheduledMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "startedMs": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "operationId",
                  "outcome",
                  "scheduledMs",
                  "startedMs"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": ["outcome", "completed", "skippedSlots", "attempted"],
          "additionalProperties": false
        },
        "targetKinds": ["session"],
        "executionLocation": "resource_host",
        "permissions": ["metadata.read", "content.read", "device.modify"],
        "stateScopes": [],
        "eventTypes": [],
        "cancellation": "cooperative",
        "revealTarget": {
          "pageId": "workbench",
          "panelId": "activity"
        }
      },
      {
        "actionId": "swb.builtin.automation.sequence",
        "kind": "action",
        "inputSchema": {
          "type": "object",
          "properties": {
            "definition": {
              "type": "string",
              "minLength": 2,
              "maxLength": 32768
            },
            "startEventSeq": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            }
          },
          "required": ["definition", "startEventSeq"],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "outcome": {
              "enum": [
                "completed",
                "matched",
                "response_timeout",
                "response_ambiguous",
                "unexpected_response",
                "source_changed",
                "transmit_unconfirmed",
                "stop_condition"
              ]
            },
            "completedSteps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "stoppedAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "attempts": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "operationId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "outcome": {
                    "enum": [
                      "written",
                      "matched",
                      "response_timeout",
                      "response_ambiguous",
                      "unexpected_response",
                      "source_changed",
                      "transmit_unconfirmed",
                      "stop_condition"
                    ]
                  },
                  "source": {
                    "$ref": "#/$defs/source"
                  }
                },
                "required": ["path", "operationId", "outcome"],
                "additionalProperties": false
              }
            }
          },
          "required": ["outcome", "completedSteps", "attempts"],
          "additionalProperties": false,
          "$defs": {
            "position": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,19})$"
            },
            "source": {
              "type": "object",
              "properties": {
                "hostId": {
                  "type": "string"
                },
                "sessionId": {
                  "type": "string"
                },
                "sessionEpoch": {
                  "$ref": "#/$defs/position"
                },
                "direction": {
                  "const": "rx"
                },
                "eventStart": {
                  "$ref": "#/$defs/position"
                },
                "eventEnd": {
                  "$ref": "#/$defs/position"
                },
                "byteStart": {
                  "$ref": "#/$defs/position"
                },
                "byteEnd": {
                  "$ref": "#/$defs/position"
                }
              },
              "required": [
                "hostId",
                "sessionId",
                "sessionEpoch",
                "direction",
                "eventStart",
                "eventEnd",
                "byteStart",
                "byteEnd"
              ],
              "additionalProperties": false
            }
          }
        },
        "targetKinds": ["session"],
        "executionLocation": "resource_host",
        "permissions": ["metadata.read", "content.read", "device.modify"],
        "stateScopes": [],
        "eventTypes": [],
        "cancellation": "cooperative",
        "revealTarget": {
          "pageId": "workbench",
          "panelId": "activity"
        }
      },
      {
        "actionId": "swb.builtin.automation.rule",
        "kind": "action",
        "inputSchema": {
          "type": "object",
          "properties": {
            "definition": {
              "type": "string",
              "minLength": 2,
              "maxLength": 32768
            },
            "startEventSeq": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            }
          },
          "required": ["definition", "startEventSeq"],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "outcome": {
              "enum": [
                "timed_out",
                "source_changed",
                "already_armed",
                "notification",
                "written",
                "transmit_unconfirmed",
                "action_completed",
                "action_failed",
                "action_unconfirmed"
              ]
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "operationId": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": ["outcome"],
          "additionalProperties": false,
          "$defs": {
            "position": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,19})$"
            },
            "source": {
              "type": "object",
              "properties": {
                "hostId": {
                  "type": "string"
                },
                "sessionId": {
                  "type": "string"
                },
                "sessionEpoch": {
                  "$ref": "#/$defs/position"
                },
                "direction": {
                  "const": "rx"
                },
                "eventStart": {
                  "$ref": "#/$defs/position"
                },
                "eventEnd": {
                  "$ref": "#/$defs/position"
                },
                "byteStart": {
                  "$ref": "#/$defs/position"
                },
                "byteEnd": {
                  "$ref": "#/$defs/position"
                }
              },
              "required": [
                "hostId",
                "sessionId",
                "sessionEpoch",
                "direction",
                "eventStart",
                "eventEnd",
                "byteStart",
                "byteEnd"
              ],
              "additionalProperties": false
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "outcome": {
                    "const": "notification"
                  }
                }
              },
              "then": {
                "required": ["source", "message"]
              }
            },
            {
              "if": {
                "properties": {
                  "outcome": {
                    "enum": [
                      "written",
                      "transmit_unconfirmed",
                      "action_completed",
                      "action_failed",
                      "action_unconfirmed"
                    ]
                  }
                }
              },
              "then": {
                "required": ["source", "operationId"]
              }
            }
          ]
        },
        "targetKinds": ["session"],
        "executionLocation": "resource_host",
        "permissions": ["metadata.read", "content.read", "device.modify"],
        "stateScopes": [],
        "eventTypes": [],
        "cancellation": "cooperative",
        "revealTarget": {
          "pageId": "workbench",
          "panelId": "activity"
        }
      },
      {
        "actionId": "swb.builtin.automation.calendar",
        "kind": "action",
        "inputSchema": {
          "type": "object",
          "properties": {
            "schedule": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "once"
                    },
                    "at": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,3})?(Z|[+-][0-9]{2}:[0-9]{2})$"
                    }
                  },
                  "required": ["kind", "at"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "cron"
                    },
                    "expression": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "timeZone": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  "required": ["kind", "expression", "timeZone"],
                  "additionalProperties": false
                }
              ]
            },
            "bytesBase64": {
              "type": "string",
              "minLength": 4,
              "maxLength": 344,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "sessionRevision": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,19})$"
            },
            "endAt": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,3})?(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32,
              "default": 1
            }
          },
          "required": ["schedule", "bytesBase64", "sessionRevision"],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "schedule": {
                    "properties": {
                      "kind": {
                        "const": "cron"
                      }
                    }
                  }
                }
              },
              "then": {
                "required": ["endAt"]
              },
              "else": {
                "properties": {
                  "count": {
                    "const": 1
                  }
                },
                "not": {
                  "required": ["endAt"]
                }
              }
            }
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "outcome": {
              "enum": [
                "completed",
                "completed_with_misses",
                "missed",
                "window_ended",
                "transmit_unconfirmed",
                "capacity_reached"
              ]
            },
            "runs": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "properties": {
                  "scheduledMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "observedMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "operationId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "outcome": {
                    "enum": ["written", "missed", "transmit_unconfirmed"]
                  }
                },
                "required": [
                  "scheduledMs",
                  "observedMs",
                  "operationId",
                  "outcome"
                ],
                "additionalProperties": false
              }
            },
            "skipped": {
              "type": "array",
              "maxItems": 33,
              "items": {
                "type": "object",
                "properties": {
                  "firstMs": {
                    "type": "integer"
                  },
                  "throughMs": {
                    "type": "integer"
                  }
                },
                "required": ["firstMs", "throughMs"],
                "additionalProperties": false
              }
            }
          },
          "required": ["outcome", "runs", "skipped"],
          "additionalProperties": false
        },
        "targetKinds": ["session"],
        "executionLocation": "resource_host",
        "permissions": ["metadata.read", "content.read", "device.modify"],
        "stateScopes": [],
        "eventTypes": [],
        "cancellation": "cooperative",
        "revealTarget": {
          "pageId": "workbench",
          "panelId": "activity"
        }
      },
