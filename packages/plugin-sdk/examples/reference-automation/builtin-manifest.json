      {
        "actionId": "swb.builtin.automation.connect",
        "kind": "action",
        "inputSchema": {
          "type": "object",
          "properties": {
            "configuration": {
              "type": "object",
              "properties": {
                "baudRate": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,19}$"
                },
                "dataBits": {
                  "type": "string"
                },
                "parity": {
                  "type": "string"
                },
                "stopBits": {
                  "type": "string"
                },
                "flowControl": {
                  "type": "string",
                  "enum": ["none", "rtsCts", "xonXoff", "dsrDtr"]
                },
                "readWaitMs": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$"
                },
                "writeWaitMs": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$"
                },
                "reconnectBackoffMs": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$"
                }
              },
              "required": [
                "baudRate",
                "dataBits",
                "parity",
                "stopBits",
                "flowControl",
                "readWaitMs",
                "writeWaitMs",
                "reconnectBackoffMs"
              ],
              "additionalProperties": false
            },
            "definition": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "integer",
                  "const": 1
                },
                "beforeOpenMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 30000
                },
                "steps": {
                  "type": "array",
                  "maxItems": 16,
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": ["line"]
