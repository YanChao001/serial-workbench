{
  "schemaVersion": "0.1",
  "id": "swb.reference.automation",
  "version": "0.1.6",
  "displayName": "Serial Workbench Automation",
  "description": "Run serial schedules, response checks and Modbus transactions",
  "license": "Apache-2.0",
  "notices": ["LICENSE", "NOTICE"],
  "hostProtocolVersion": "0.1",
  "runtimeRef": "node-26.13.0",
  "main": "dist/main.mjs",
  "dependencies": [],
  "platformResources": [],
  "activation": ["startup"],
  "permissions": {
    "hostApi": [
      {
        "permissions": ["metadata.read", "content.read", "device.modify"],
        "targetKinds": ["session"]
      }
    ],
    "executionPurposes": ["automation"],
    "externalTools": []
  },
  "contributes": {
    "actions": [
      {
        "actionId": "swb.reference.automation.run",
        "kind": "action",
        "inputSchema": {
          "type": "object",
          "properties": {
            "startEventSeq": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$",
              "default": "1"
            },
            "responseTimeoutMs": {
              "type": "integer",
              "minimum": 50,
              "maximum": 5000,
              "default": 1000
            },
            "lateResponseWaitMs": {
              "description": "Extra observation time for the same response after its deadline",
              "type": "integer",
              "minimum": 0,
              "maximum": 3000,
              "default": 0
            },
            "rounds": {
              "description": "Expected-response rounds with a three-second pause between rounds",
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "default": 1
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "properties": {
                  "sendBase64": { "$ref": "#/$defs/frame" },
                  "expectBase64": { "$ref": "#/$defs/frame" }
                },
                "required": ["sendBase64", "expectBase64"],
                "additionalProperties": false
              }
            }
          },
          "required": ["steps"],
          "additionalProperties": false,
          "$defs": {
            "frame": {
              "type": "string",
              "minLength": 4,
              "maxLength": 344,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "outcome": { "$ref": "#/$defs/outcome" },
            "completedSteps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "attempted": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "operationId": { "type": "string" },
                  "outcome": { "$ref": "#/$defs/outcome" },
                  "source": { "$ref": "#/$defs/source" },
                  "lateResponse": { "$ref": "#/$defs/source" }
                },
                "required": ["operationId", "outcome"],
                "additionalProperties": false
              }
            }
          },
          "required": ["outcome", "completedSteps", "attempted"],
          "additionalProperties": false,
          "$defs": {
            "outcome": {
              "enum": [
                "matched",
                "unexpected_response",
                "response_timeout",
                "source_changed",
                "transmit_unconfirmed"
              ]
            },
            "position": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,19})$"
            },
            "source": {
              "type": "object",
              "properties": {
                "hostId": { "type": "string" },
                "sessionId": { "type": "string" },
                "sessionEpoch": { "$ref": "#/$defs/position" },
                "direction": { "const": "rx" },
                "eventStart": { "$ref": "#/$defs/position" },
                "eventEnd": { "$ref": "#/$defs/position" },
                "byteStart": { "$ref": "#/$defs/position" },
                "byteEnd": { "$ref": "#/$defs/position" }
              },
              "required": [
                "hostId",
                "sessionId",
                "sessionEpoch",
                "direction",
                "eventStart",
                "eventEnd",
                "byteStart",
                "byteEnd"
              ],
              "additionalProperties": false
            }
          }
        },
        "targetKinds": ["session"],
        "executionLocation": "resource_host",
        "permissions": ["metadata.read", "content.read", "device.modify"],
        "stateScopes": [],
        "eventTypes": [],
        "cancellation": "cooperative",
        "revealTarget": { "pageId": "workbench", "panelId": "activity" }
      },
      {
        "actionId": "swb.reference.automation.repeat",
        "kind": "action",
        "inputSchema": {
          "type": "object",
          "properties": {
            "sendBase64": {
              "$ref": "#/$defs/frame"
            },
            "periodMs": {
              "type": "integer",
              "minimum": 10,
              "maximum": 60000
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "jitterMs": {
              "description": "Symmetric offset smaller than half the period",
              "type": "integer",
              "minimum": 0,
              "maximum": 29999,
              "default": 0
            },
            "startDelayMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60000,
              "default": 0
            },
            "startOnBase64": {
              "$ref": "#/$defs/frame"
            },
            "startTimeoutMs": {
              "type": "integer",
              "minimum": 50,
              "maximum": 60000,
              "default": 5000
            },
            "stopOnBase64": {
              "$ref": "#/$defs/frame"
            },
            "expectBase64": {
              "$ref": "#/$defs/frame"
            },
            "responseTimeoutMs": {
              "type": "integer",
              "minimum": 50,
              "maximum": 5000,
              "default": 1000
            },
            "startEventSeq": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$",
              "default": "1"
            }
          },
          "required": ["sendBase64", "periodMs", "count"],
          "additionalProperties": false,
          "$defs": {
            "frame": {
              "type": "string",
              "minLength": 4,
              "maxLength": 344,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "outcome": {
              "enum": [
                "completed",
                "start_timeout",
                "stop_condition",
                "unexpected_response",
                "response_timeout",
                "source_changed",
                "transmit_unconfirmed"
              ]
            },
            "completed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "skippedSlots": {
              "type": "integer",
              "minimum": 0
            },
            "attempted": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "operationId": {
                    "type": "string"
                  },
                  "outcome": {
                    "enum": [
                      "written",
                      "matched",
                      "stop_condition",
                      "unexpected_response",
                      "response_timeout",
                      "source_changed",
                      "transmit_unconfirmed"
                    ]
                  },
                  "scheduledMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "startedMs": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "operationId",
                  "outcome",
                  "scheduledMs",
                  "startedMs"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": ["outcome", "completed", "skippedSlots", "attempted"],
          "additionalProperties": false
        },
        "targetKinds": ["session"],
        "executionLocation": "resource_host",
        "permissions": ["metadata.read", "content.read", "device.modify"],
        "stateScopes": [],
        "eventTypes": [],
        "cancellation": "cooperative",
        "revealTarget": {
          "pageId": "workbench",
          "panelId": "activity"
        }
      },
      {
        "actionId": "swb.reference.automation.modbus",
        "kind": "action",
        "inputSchema": {
          "type": "object",
          "properties": {
            "transport": {
              "enum": ["rtu", "ascii", "tcp"]
            },
            "requestBase64": {
              "type": "string",
              "minLength": 4,
              "maxLength": 684,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "unitRouting": {
              "enum": ["gateway", "direct"]
            },
            "startEventSeq": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$",
              "default": "1"
            },
            "responseTimeoutMs": {
              "type": "integer",
              "minimum": 50,
              "maximum": 5000,
              "default": 1000
            },
            "lateResponseWaitMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3000,
              "default": 0
            },
            "broadcastTurnaroundMs": {
              "type": "integer",
              "minimum": 10,
              "maximum": 2000,
              "default": 150
            },
            "retryLimit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2,
              "default": 0
            },
            "includeTrace": {
              "type": "boolean",
              "default": false
            }
          },
          "required": ["transport", "requestBase64"],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "operationId": {
              "type": "string"
            },
            "outcome": {
              "enum": [
                "matched",
                "device_exception",
                "invalid_response",
                "response_timeout",
                "source_changed",
                "transmit_unconfirmed",
                "broadcast_completed"
              ]
            },
            "ignoredFrames": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            },
            "turnaroundMs": {
              "type": "integer",
              "minimum": 10,
              "maximum": 2000
            },
            "response": {
              "$ref": "#/$defs/received"
            },
            "lateResponse": {
              "$ref": "#/$defs/received"
            },
            "retryStopped": {
              "enum": ["partial_frame", "lease_budget"]
            },
            "attempts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "properties": {
                  "operationId": { "$ref": "#/properties/operationId" },
                  "outcome": { "$ref": "#/properties/outcome" },
                  "ignoredFrames": { "$ref": "#/properties/ignoredFrames" },
                  "response": { "$ref": "#/$defs/received" },
                  "lateResponse": { "$ref": "#/$defs/received" },
                  "trace": {
                    "type": "object",
                    "properties": {
                      "tx": { "$ref": "#/$defs/timingPoint" },
                      "rxFirst": { "$ref": "#/$defs/timingPoint" },
                      "rxLast": { "$ref": "#/$defs/timingPoint" }
                    },
                    "required": ["tx"],
                    "dependentRequired": {
                      "rxFirst": ["rxLast"],
                      "rxLast": ["rxFirst"]
                    },
                    "additionalProperties": false
                  },
                  "requestTransactionId": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  }
                },
                "required": ["operationId", "outcome", "ignoredFrames"],
                "additionalProperties": false
              }
            }
          },
          "required": ["operationId", "outcome", "ignoredFrames"],
          "additionalProperties": false,
          "$defs": {
            "timingPoint": {
              "type": "object",
              "properties": {
                "eventSeq": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,19}$"
                },
                "clockId": { "type": "string" },
                "monoNs": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "resolutionNs": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "source": { "$ref": "#/$defs/precision/properties/source" }
              },
              "required": [
                "eventSeq",
                "clockId",
                "monoNs",
                "source",
                "resolutionNs"
              ],
              "additionalProperties": false
            },
            "precision": {
              "type": "object",
              "properties": {
                "source": {
                  "enum": [
                    "host_read",
                    "device",
                    "line_capture",
                    "sample_clock"
                  ]
                },
                "resolutionNs": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "syncMethod": {
                  "type": "string"
                },
                "offsetEstimateNs": {
                  "type": "string",
                  "pattern": "^-?(?:0|[1-9][0-9]{0,19})$"
                },
                "offsetErrorNs": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "rttNs": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                }
              },
              "required": ["source", "resolutionNs", "syncMethod"],
              "additionalProperties": false
            },
            "source": {
              "type": "object",
              "properties": {
                "hostId": {
                  "type": "string"
                },
                "sessionId": {
                  "type": "string"
                },
                "sessionEpoch": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "direction": {
                  "const": "rx"
                },
                "eventStart": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "eventEnd": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "byteStart": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "byteEnd": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                }
              },
              "required": [
                "hostId",
                "sessionId",
                "sessionEpoch",
                "direction",
                "eventStart",
                "eventEnd",
                "byteStart",
                "byteEnd"
              ],
              "additionalProperties": false
            },
            "timing": {
              "type": "object",
              "properties": {
                "clockId": {
                  "type": "string"
                },
                "txMonoNs": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "rxMonoNs": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "elapsedNs": {
                  "type": "string",
                  "pattern": "^(?:0|[1-9][0-9]{0,19})$"
                },
                "attemptAttribution": {
                  "const": "indeterminate"
                },
                "txPrecision": {
                  "$ref": "#/$defs/precision"
                },
                "rxPrecision": {
                  "$ref": "#/$defs/precision"
                }
              },
              "required": [
                "clockId",
                "txMonoNs",
                "rxMonoNs",
                "txPrecision",
                "rxPrecision"
              ],
              "oneOf": [
                { "required": ["elapsedNs"] },
                { "required": ["attemptAttribution"] }
              ],
              "additionalProperties": false
            },
            "received": {
              "type": "object",
              "properties": {
                "source": {
                  "$ref": "#/$defs/source"
                },
                "timing": {
                  "$ref": "#/$defs/timing"
                },
                "bytesBase64": {
                  "type": "string",
                  "minLength": 4,
                  "maxLength": 684,
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                },
                "exceptionCode": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 255
                }
              },
              "required": ["source", "timing", "bytesBase64"],
              "additionalProperties": false
            }
          }
        },
        "targetKinds": ["session"],
        "executionLocation": "resource_host",
        "permissions": ["metadata.read", "content.read", "device.modify"],
        "stateScopes": [],
        "eventTypes": [],
        "cancellation": "cooperative",
        "revealTarget": {
          "pageId": "workbench",
          "panelId": "activity"
        }
      }
    ],
    "queries": [],
    "transports": [],
    "parsers": [],
    "views": [],
    "themes": [],
    "configuration": []
  },
  "dataSchemaVersion": "1"
}
