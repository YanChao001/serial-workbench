{
  "schemaVersion": "0.1",
  "id": "swb.reference.automation",
  "version": "0.1.2",
  "displayName": "Serial Workbench Automation",
  "description": "Run one or more paced rounds and verify each serial response",
  "license": "Apache-2.0",
  "notices": ["LICENSE", "NOTICE"],
  "hostProtocolVersion": "0.1",
  "runtimeRef": "node-26.13.0",
  "main": "dist/main.mjs",
  "dependencies": [],
  "platformResources": [],
  "activation": ["startup"],
  "permissions": {
    "hostApi": [
      {
        "permissions": ["metadata.read", "content.read", "device.modify"],
        "targetKinds": ["session"]
      }
    ],
    "executionPurposes": ["automation"],
    "externalTools": []
  },
  "contributes": {
    "actions": [
      {
        "actionId": "swb.reference.automation.run",
        "kind": "action",
        "inputSchema": {
          "type": "object",
          "properties": {
            "startEventSeq": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$",
              "default": "1"
            },
            "responseTimeoutMs": {
              "type": "integer",
              "minimum": 50,
              "maximum": 5000,
              "default": 1000
            },
            "lateResponseWaitMs": {
              "description": "Extra observation time for the same response after its deadline",
              "type": "integer",
              "minimum": 0,
              "maximum": 3000,
              "default": 0
            },
            "rounds": {
              "description": "Expected-response rounds with a three-second pause between rounds",
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "default": 1
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "properties": {
                  "sendBase64": { "$ref": "#/$defs/frame" },
                  "expectBase64": { "$ref": "#/$defs/frame" }
                },
                "required": ["sendBase64", "expectBase64"],
                "additionalProperties": false
              }
            }
          },
          "required": ["steps"],
          "additionalProperties": false,
          "$defs": {
            "frame": {
              "type": "string",
              "minLength": 4,
              "maxLength": 344,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "outcome": { "$ref": "#/$defs/outcome" },
            "completedSteps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "attempted": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "operationId": { "type": "string" },
                  "outcome": { "$ref": "#/$defs/outcome" },
                  "source": { "$ref": "#/$defs/source" },
                  "lateResponse": { "$ref": "#/$defs/source" }
                },
                "required": ["operationId", "outcome"],
                "additionalProperties": false
              }
            }
          },
          "required": ["outcome", "completedSteps", "attempted"],
          "additionalProperties": false,
          "$defs": {
            "outcome": {
              "enum": [
                "matched",
                "unexpected_response",
                "response_timeout",
                "source_changed",
                "transmit_unconfirmed"
              ]
            },
            "position": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,19})$"
            },
            "source": {
              "type": "object",
              "properties": {
                "hostId": { "type": "string" },
                "sessionId": { "type": "string" },
                "sessionEpoch": { "$ref": "#/$defs/position" },
                "direction": { "const": "rx" },
                "eventStart": { "$ref": "#/$defs/position" },
                "eventEnd": { "$ref": "#/$defs/position" },
                "byteStart": { "$ref": "#/$defs/position" },
                "byteEnd": { "$ref": "#/$defs/position" }
              },
              "required": [
                "hostId",
                "sessionId",
                "sessionEpoch",
                "direction",
                "eventStart",
                "eventEnd",
                "byteStart",
                "byteEnd"
              ],
              "additionalProperties": false
            }
          }
        },
        "targetKinds": ["session"],
        "executionLocation": "resource_host",
        "permissions": ["metadata.read", "content.read", "device.modify"],
        "stateScopes": [],
        "eventTypes": [],
        "cancellation": "cooperative",
        "revealTarget": { "pageId": "workbench", "panelId": "activity" }
      }
    ],
    "queries": [],
    "transports": [],
    "parsers": [],
    "views": [],
    "themes": [],
    "configuration": []
  },
  "dataSchemaVersion": "1"
}
