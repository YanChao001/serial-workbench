                  },
                  "toMonoNs": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})$"
                  },
                  "partial": {
                    "type": "boolean"
                  },
                  "expectedCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8192
                  },
                  "validCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8192
