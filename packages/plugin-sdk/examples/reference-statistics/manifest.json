{
  "schemaVersion": "0.1",
  "id": "swb.reference.statistics",
  "version": "0.1.0",
  "displayName": "Sample Window Statistics",
  "description": "Summarize declared sample grids with overlapping count or monotonic time windows",
  "license": "Apache-2.0",
  "notices": ["LICENSE", "NOTICE"],
  "hostProtocolVersion": "0.1",
  "runtimeRef": "node-26.13.0",
  "main": "dist/main.mjs",
  "dependencies": [],
  "platformResources": [],
  "activation": ["startup"],
  "permissions": {
    "hostApi": [],
    "executionPurposes": ["chart"],
    "externalTools": []
  },
  "contributes": {
    "actions": [
      {
        "actionId": "swb.reference.statistics.windows",
        "kind": "action",
        "inputSchema": {
          "type": "object",
          "properties": {
            "firstPosition": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "expectedSlots": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            },
            "unit": {
              "type": "string",
              "maxLength": 32
            },
            "samples": {
              "type": "array",
              "maxItems": 512,
              "items": {
                "type": "object",
                "properties": {
                  "position": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$"
                  },
                  "value": {
                    "type": "number"
                  }
                },
                "required": ["position", "value"],
                "additionalProperties": false
              }
            },
            "window": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": ["count"]
                    },
                    "length": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]{0,19}$"
                    },
                    "step": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]{0,19}$"
                    }
                  },
                  "required": ["kind", "length", "step"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": ["time"]
                    },
                    "length": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]{0,19}$"
                    },
                    "step": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]{0,19}$"
                    },
                    "clockId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
                    },
                    "originMonoNs": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]{0,19})$"
                    },
                    "periodNs": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]{0,19}$"
                    }
                  },
                  "required": [
                    "kind",
                    "length",
                    "step",
                    "clockId",
                    "originMonoNs",
                    "periodNs"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": ["firstPosition", "expectedSlots", "samples", "window"],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["count", "time"]
            },
            "length": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "step": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "firstPosition": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "expectedSlots": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            },
            "unit": {
              "type": "string",
              "maxLength": 32
            },
            "clockId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
            },
            "originMonoNs": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "periodNs": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "windows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "type": "object",
                "properties": {
                  "fromPosition": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$"
                  },
                  "toPosition": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,19}$"
                  },
                  "fromMonoNs": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})$"
                  },
                  "toMonoNs": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})$"
                  },
                  "partial": {
                    "type": "boolean"
                  },
                  "expectedCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8192
                  },
                  "validCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8192
                  },
                  "missingCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8192
                  },
                  "missingRate": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "metrics": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "minimum": {
                            "type": "number"
                          },
                          "maximum": {
                            "type": "number"
                          },
                          "average": {
                            "type": "number"
                          },
                          "deviation": {
                            "type": "number"
                          },
                          "p50": {
                            "type": "number"
                          },
                          "p95": {
                            "type": "number"
                          },
                          "p99": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "minimum",
                          "maximum",
                          "average",
                          "deviation",
                          "p50",
                          "p95",
                          "p99"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "fromPosition",
                  "toPosition",
                  "partial",
                  "expectedCount",
                  "validCount",
                  "missingCount",
                  "missingRate",
                  "metrics"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "length",
            "step",
            "firstPosition",
            "expectedSlots",
            "windows"
          ],
          "additionalProperties": false
        },
        "targetKinds": ["host"],
        "executionLocation": "resource_host",
        "permissions": ["metadata.read"],
        "stateScopes": [],
        "eventTypes": [],
        "cancellation": "cooperative",
        "revealTarget": {
          "pageId": "plugins"
        }
      }
    ],
    "queries": [],
    "transports": [],
    "parsers": [],
    "views": [],
    "themes": [],
    "configuration": []
  },
  "dataSchemaVersion": "1"
}
